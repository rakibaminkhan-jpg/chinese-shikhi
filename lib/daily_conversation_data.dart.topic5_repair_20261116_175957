const _saif = (
  hanzi: '赛义夫',
  pinyin: 'Sàiyìfū',
  bn: 'সাইফ',
  en: 'Saif',
);

ConversationLine _makeLine(
  int speaker,
  String chinese,
  String pinyin,
  String bengali,
  String english,
) {
  final person = switch (speaker) {
    1 => _rubel,
    2 => _saif,
    _ => _rakib,
  };

  return ConversationLine(
    speakerHanzi: person.hanzi,
    speakerPinyin: person.pinyin,
    speakerBn: person.bn,
    speakerEn: person.en,
    chinese: chinese,
    pinyin: pinyin,
    bengali: bengali,
    english: english,
  );
}

