class ConversationLine {
  final String speakerHanzi;
  final String speakerPinyin;
  final String speakerBn;
  final String speakerEn;
  final String chinese;
  final String pinyin;
  final String bengali;
  final String english;

  const ConversationLine({
    required this.speakerHanzi,
    required this.speakerPinyin,
    required this.speakerBn,
    required this.speakerEn,
    required this.chinese,
    required this.pinyin,
    required this.bengali,
    required this.english,
  });
}

class ConversationTopic {
  final int id;
  final String category;
  final String titleBn;
  final String titleEn;
  final String titleZh;
  final String icon;
  final int hskLevel;
  final List<ConversationLine> lines;
  final List<String> grammar;
  final List<String> vocabulary;

  const ConversationTopic({
    required this.id,
    required this.category,
    required this.titleBn,
    required this.titleEn,
    required this.titleZh,
    required this.icon,
    required this.hskLevel,
    required this.lines,
    required this.grammar,
    required this.vocabulary,
  });
}

