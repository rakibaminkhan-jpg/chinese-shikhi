              ],
            ),
          ),
          const SizedBox(height: 22),
          const Row(
            children: [
              Icon(Icons.auto_awesome, color: AppColors.gold, size: 20),
              SizedBox(width: 8),
              Text(
                'আপনার শেখার ড্যাশবোর্ড',
                style: TextStyle(
                  fontSize: 20,
