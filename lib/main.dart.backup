                MaterialPageRoute(builder: (_) => const VocabularyScreen())),
          ),
          MenuCard(
            icon: Icons.quiz_outlined,
            title: 'অনুশীলন কুইজ',
            subtitle: '১০টি প্রশ্ন দিয়ে নিজের দক্ষতা যাচাই করুন',
            onTap: _startQuiz,
          ),
          MenuCard(
