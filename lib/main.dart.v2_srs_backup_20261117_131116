      'pinyin': 'Shuǐ',
      'meaning': 'পানি',
      'options': ['আগুন', 'বই', 'পানি', 'মানুষ'],
      'answer': 'পানি',
    },
    {
      'hanzi': '朋友',
      'pinyin': 'Péngyou',
      'meaning': 'বন্ধু',
      'options': ['শিক্ষক', 'বন্ধু', 'ছাত্র', 'পরিবার'],
      'answer': 'বন্ধু',
    },
  ];

  int _index = 0;
  int _score = 0;
  String? _selected;
  bool _finished = false;

  void _choose(String answer) {
    if (_selected != null) return;

    setState(() {
      _selected = answer;
      if (answer == _questions[_index]['answer']) {
        _score++;
      }
    });
  }

  void _next() {
    setState(() {
      if (_index == _questions.length - 1) {
        _finished = true;
      } else {
        _index++;
        _selected = null;
      }
    });
  }

  void _restart() {
    setState(() {
      _index = 0;
      _score = 0;
      _selected = null;
      _finished = false;
    });
  }

