  Future<void> _recordStudySecond() async {
    if (_recordingStudySecond) return;

    _recordingStudySecond = true;

    try {
      final result = await LearningStore.addStudySecond();

      if (!mounted) return;

      final now = DateTime.now();

      setState(() {
        _totalStudySeconds = result['totalSeconds']!;
        _todayStudySeconds = result['todaySeconds']!;
        _totalXp = result['totalXp']!;
        _learningLevel = (_totalXp ~/ 100) + 1;

        if (_calendarMonth.year == now.year &&
            _calendarMonth.month == now.month) {
          _monthStudySeconds[now.day] = _todayStudySeconds;
        }
      });
    } finally {
      _recordingStudySecond = false;
    }
  }

  void _startStudyTimer() {
    if (_isStudyRunning) return;

    setState(() => _isStudyRunning = true);

    _studyTimer = Timer.periodic(
      const Duration(seconds: 1),
      (_) => _recordStudySecond(),
    );
  }

  void _pauseStudyTimer() {
    _studyTimer?.cancel();
    _studyTimer = null;

    if (mounted) {
      setState(() => _isStudyRunning = false);
    }
  }

  Future<void> _changeCalendarMonth(int change) async {
    final next = DateTime(
      _calendarMonth.year,
      _calendarMonth.month + change,
    );

    // ভবিষ্যতের মাসে যাওয়া যাবে না।
    final now = DateTime.now();
    if (next.isAfter(DateTime(now.year, now.month))) return;

    setState(() {
      _calendarMonth = next;
      _monthStudySeconds = {};
    });

    final data = await LearningStore.getMonthStudySeconds(next);

    if (!mounted) return;

    setState(() => _monthStudySeconds = data);
  }

  String _formatStudyTime(int seconds) {
    final hours = seconds ~/ 3600;
    final minutes = (seconds % 3600) ~/ 60;

    if (hours > 0) return '$hoursঘ $minutesমি';
    return '$minutes মিনিট';
  }

  String _formatTimer(int seconds) {
    final hours = (seconds ~/ 3600).toString().padLeft(2, '0');
    final minutes = ((seconds % 3600) ~/ 60).toString().padLeft(2, '0');
    final remaining = (seconds % 60).toString().padLeft(2, '0');

    return '$hours:$minutes:$remaining';
  }

