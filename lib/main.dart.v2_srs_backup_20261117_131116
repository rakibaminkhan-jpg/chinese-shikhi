class ProgressScreen extends StatefulWidget {
  const ProgressScreen({super.key});

  @override
  State<ProgressScreen> createState() => _ProgressScreenState();
}

class _ProgressScreenState extends State<ProgressScreen> {
  late Future<Map<String, dynamic>> _progressFuture;

  @override
  void initState() {
    super.initState();
    _progressFuture = _loadProgress();
  }

  Future<Map<String, dynamic>> _loadProgress() async {
    final prefs = await SharedPreferences.getInstance();

    final totalLearned = await LearningStore.getTotalLearnedCount();
    final todayLearned = await LearningStore.getTodayLearnedCount();
    final dailyGoal = await LearningStore.getDailyGoal();
    final streak = await LearningStore.getStreak();

    final totalXp = await LearningStore.getTotalXp();
    final level = (totalXp ~/ 100) + 1;
    final xpInLevel = totalXp % 100;
    final xpRemaining = 100 - xpInLevel;

    final score = prefs.getInt('lesson1_score');
    final scoreTotal = prefs.getInt('lesson1_total_questions') ?? 10;

    final attempts = prefs.getInt('quiz_attempts') ?? 0;
    final totalCorrect = prefs.getInt('quiz_total_correct') ?? 0;
    final totalQuestions = prefs.getInt('quiz_total_questions') ?? 0;

    final accuracy =
        totalQuestions == 0 ? 0 : (totalCorrect * 100 / totalQuestions).round();

    final now = DateTime.now();
    final dailyActivity = <Map<String, dynamic>>[];

    for (var i = 6; i >= 0; i--) {
      final date = now.subtract(Duration(days: i));
      final y = date.year.toString().padLeft(4, '0');
      final m = date.month.toString().padLeft(2, '0');
      final d = date.day.toString().padLeft(2, '0');
      final key = 'learned_on_$y-$m-$d';

      final count = (prefs.getStringList(key) ?? []).length;

      const weekdays = [
        'সোম',
        'মঙ্গল',
        'বুধ',
        'বৃহঃ',
        'শুক্র',
        'শনি',
        'রবি',
      ];

      dailyActivity.add({
        'day': weekdays[date.weekday - 1],
        'count': count,
      });
    }

    return {
      'totalLearned': totalLearned,
      'todayLearned': todayLearned,
      'dailyGoal': dailyGoal,
      'streak': streak,
      'totalXp': totalXp,
      'level': level,
      'xpInLevel': xpInLevel,
      'xpRemaining': xpRemaining,
      'score': score,
      'scoreTotal': scoreTotal,
      'attempts': attempts,
      'accuracy': accuracy,
      'dailyActivity': dailyActivity,
    };
  }

  Future<void> _refresh() async {
    setState(() {
      _progressFuture = _loadProgress();
    });
    await _progressFuture;
  }

