class VocabularyScreen extends StatefulWidget {
  final int? level;
  final ScrollController? scrollController;

  const VocabularyScreen({
    super.key,
    this.level,
    this.scrollController,
  });

  @override
  State<VocabularyScreen> createState() => _VocabularyScreenState();
}

class _VocabularyScreenState extends State<VocabularyScreen> {
  late final Future<List<VocabWord>> _futureWords;
  late final ScrollController _scrollController;
  bool _showScrollToTop = false;
  final TextEditingController _searchController = TextEditingController();

  final Set<int> _selectedLevels = {};
  String _searchText = '';
  String _activeFilter = 'সব';
  Set<String> _favorites = {};
  Set<String> _learned = {};

  static const List<int> _levels = [1, 2, 3, 4];

  Color _levelColor(int level) {
    const palette = [
      Color(0xFF16804A), // Green
      Color(0xFFB8860B), // Yellow / Amber
      Color(0xFFB3261E), // Red
      Color(0xFFB08D35), // Gold
    ];
    return palette[(level - 1).clamp(0, palette.length - 1)];
  }

  String _wordId(VocabWord word) {
    return LearningStore.wordId(
      level: word.level,
      hanzi: word.hanzi,
      pinyin: word.pinyin,
    );
  }

  Future<void> _loadLearningState() async {
    final favorites = await LearningStore.getFavorites();
    final learned = await LearningStore.getLearnedWords();

    if (!mounted) return;

    setState(() {
      _favorites = favorites;
      _learned = learned;
    });
  }

  Future<void> _toggleFavorite(VocabWord word) async {
    final id = _wordId(word);
    await LearningStore.toggleFavorite(id);

    if (!mounted) return;

    setState(() {
      _favorites = {..._favorites};
      if (_favorites.contains(id)) {
        _favorites.remove(id);
      } else {
        _favorites.add(id);
      }
    });
  }

  Future<void> _markLearned(VocabWord word) async {
    final id = _wordId(word);
    if (_learned.contains(id)) return;

    await LearningStore.markLearned(id);

    if (!mounted) return;

    setState(() {
      _learned = {..._learned, id};
    });

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('${word.hanzi} — শেখা শব্দ হিসেবে সংরক্ষিত হয়েছে'),
        behavior: SnackBarBehavior.floating,
      ),
    );
  }

  Future<void> _openWordDetails(
    VocabWord word,
    List<VocabWord> allWords,
  ) async {
    await Navigator.push(
      context,
      MaterialPageRoute(
        builder: (_) => VocabularyDetailsScreen(
          word: word,
          allWords: allWords,
        ),
      ),
    );

    if (mounted) {
      await _loadLearningState();
    }
  }

  @override
  void initState() {
    super.initState();
    _scrollController = widget.scrollController ?? ScrollController();
    _scrollController.addListener(_handleScroll);
    _futureWords = VocabService.loadWords();
    _loadLearningState();
  }

  void _handleScroll() {
    final shouldShow =
        _scrollController.hasClients && _scrollController.offset > 300;

    if (shouldShow != _showScrollToTop && mounted) {
      setState(() => _showScrollToTop = shouldShow);
    }
  }

  @override
  void dispose() {
    _scrollController.removeListener(_handleScroll);
    if (widget.scrollController == null) {
      _scrollController.dispose();
    }
    _searchController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final colors = theme.colorScheme;
    final isDark = theme.brightness == Brightness.dark;

    return Scaffold(
      floatingActionButton: widget.scrollController != null && _showScrollToTop
          ? FloatingActionButton.small(
              tooltip: 'উপরে যান',
              backgroundColor: AppColors.gold,
              foregroundColor: AppColors.deepRed,
              onPressed: () {
                if (_scrollController.hasClients) {
                  _scrollController.animateTo(
                    0,
                    duration: const Duration(milliseconds: 450),
                    curve: Curves.easeOutCubic,
                  );
                }
              },
              child: const Icon(
                Icons.keyboard_arrow_up_rounded,
                size: 30,
              ),
            )
          : null,
      backgroundColor: isDark ? colors.surface : AppColors.ivory,
      appBar: AppBar(
        elevation: 0,
        title: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'শব্দ ভান্ডার',
              style: TextStyle(fontWeight: FontWeight.w900),
            ),
            Text(
              widget.level == null
                  ? 'চীনা ভাষা শিখুন প্রতিদিন'
                  : 'New HSK ${widget.level} শব্দ',
              style: const TextStyle(
                fontSize: 11,
                fontWeight: FontWeight.w600,
              ),
            ),
          ],
        ),
        actions: [
          IconButton(
            tooltip: 'শেখার অগ্রগতি',
            onPressed: () {
              Navigator.push(
                context,
                MaterialPageRoute(
                  builder: (_) => const ProgressScreen(),
                ),
              );
            },
            icon: const Icon(Icons.insights_rounded),
          ),
          const SizedBox(width: 6),
        ],
      ),
      body: FutureBuilder<List<VocabWord>>(
        future: _futureWords,
        builder: (context, snapshot) {
          if (snapshot.connectionState == ConnectionState.waiting) {
            return const Center(child: CircularProgressIndicator());
          }

          if (snapshot.hasError) {
            return Center(
              child: Padding(
                padding: const EdgeInsets.all(24),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    const Icon(
                      Icons.error_outline_rounded,
                      size: 48,
                      color: AppColors.red,
                    ),
                    const SizedBox(height: 12),
                    const Text(
                      'শব্দ লোড করা যায়নি',
                      style: TextStyle(fontWeight: FontWeight.w900),
                    ),
                    const SizedBox(height: 8),
                    Text('${snapshot.error}'),
                    const SizedBox(height: 12),
                    FilledButton(
                      onPressed: () => setState(() {}),
                      child: const Text('আবার চেষ্টা করুন'),
                    ),
                  ],
                ),
              ),
            );
          }

          final allWords = snapshot.data ?? [];

          if (allWords.isEmpty) {
            return const Center(child: Text('কোনো শব্দ পাওয়া যায়নি।'));
          }

          final progressWords = widget.level == null
              ? allWords
              : allWords.where((w) => w.level == widget.level).toList();

          final learnedCount =
              progressWords.where((w) => _learned.contains(_wordId(w))).length;

          final favoriteCount = progressWords
              .where((w) => _favorites.contains(_wordId(w)))
              .length;

          final progress = progressWords.isEmpty
              ? 0.0
              : (learnedCount / progressWords.length)
                  .clamp(0.0, 1.0)
                  .toDouble();

          final query = _searchText.trim().toLowerCase();

          final filteredWords = allWords.where((word) {
            final matchesLevel = widget.level != null
                ? word.level == widget.level
                : (_selectedLevels.isEmpty ||
                    _selectedLevels.contains(word.level));

            final matchesSearch = query.isEmpty ||
                word.hanzi.toLowerCase().contains(query) ||
                word.pinyin.toLowerCase().contains(query) ||
                word.meaning.toLowerCase().contains(query) ||
                word.meaningBn.toLowerCase().contains(query);

            final id = _wordId(word);
            final matchesFilter = switch (_activeFilter) {
              'না-শেখা' => !_learned.contains(id),
              'শেখা' => _learned.contains(id),
              'প্রিয়' => _favorites.contains(id),
              _ => true,
            };

            return matchesLevel && matchesSearch && matchesFilter;
          }).toList();

