class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  int _selectedIndex = 0;
  DateTime? _lastBackPressed;

  void _handleBackPressed() {
    final keys = [
      _homeNavigatorKey,
      _learnNavigatorKey,
      _grammarNavigatorKey,
      _practiceNavigatorKey,
      _speakingNavigatorKey,
      _profileNavigatorKey,
    ];

    final currentNavigator = keys[_selectedIndex].currentState;

    // বর্তমান ট্যাবের ভেতরে আগের পেজ থাকলে সেখানে ফিরে যাবে।
    if (currentNavigator?.canPop() ?? false) {
      currentNavigator!.pop();
      return;
    }

    // অন্য ট্যাবে থাকলে Home ট্যাবে ফিরে যাবে।
    if (_selectedIndex != 0) {
      setState(() => _selectedIndex = 0);
      return;
    }

    // Home-এ দুইবার Back চাপলে অ্যাপ বন্ধ হবে।
    final now = DateTime.now();

    if (_lastBackPressed != null &&
        now.difference(_lastBackPressed!) < const Duration(seconds: 2)) {
      SystemNavigator.pop();
      return;
    }

    _lastBackPressed = now;

    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(
        const SnackBar(
          content: Text('আবার Back চাপলে অ্যাপ বন্ধ হবে।'),
          duration: Duration(seconds: 2),
          behavior: SnackBarBehavior.floating,
        ),
      );
  }

  final ScrollController _homeScrollController = ScrollController();
  final ScrollController _learnScrollController = ScrollController();
  final ScrollController _grammarScrollController = ScrollController();
  final ScrollController _practiceScrollController = ScrollController();
  final ScrollController _speakingScrollController = ScrollController();

  final _homeNavigatorKey = GlobalKey<NavigatorState>();
  final _learnNavigatorKey = GlobalKey<NavigatorState>();
  final _grammarNavigatorKey = GlobalKey<NavigatorState>();
  final _practiceNavigatorKey = GlobalKey<NavigatorState>();
  final _speakingNavigatorKey = GlobalKey<NavigatorState>();
  final _profileNavigatorKey = GlobalKey<NavigatorState>();

  void _scrollTabToTop(int index) {
    final controllers = [
      _homeScrollController,
      _learnScrollController,
      _grammarScrollController,
      _practiceScrollController,
      _speakingScrollController,
    ];

    if (index < 0 || index >= controllers.length) return;

    final controller = controllers[index];
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!mounted || !controller.hasClients) return;
      controller.animateTo(
        0,
        duration: const Duration(milliseconds: 450),
        curve: Curves.easeOutCubic,
      );
    });
  }

  void _selectTab(int index) {
    if (index == _selectedIndex) {
      final keys = [
        _homeNavigatorKey,
        _learnNavigatorKey,
        _grammarNavigatorKey,
        _practiceNavigatorKey,
        _speakingNavigatorKey,
        _profileNavigatorKey,
      ];
      keys[index].currentState?.popUntil((route) => route.isFirst);
      _scrollTabToTop(index);
      return;
    }

    setState(() => _selectedIndex = index);
    _scrollTabToTop(index);
  }

  Widget _tabNavigator({
    required GlobalKey<NavigatorState> navigatorKey,
    required Widget initialPage,
  }) {
    return Navigator(
      key: navigatorKey,
      onGenerateRoute: (settings) => MaterialPageRoute<void>(
        settings: settings,
        builder: (_) => initialPage,
      ),
    );
  }

  @override
  void dispose() {
    _homeScrollController.dispose();
    _learnScrollController.dispose();
    _grammarScrollController.dispose();
    _practiceScrollController.dispose();
    _speakingScrollController.dispose();
    super.dispose();
  }

