  State<QuizScreen> createState() => _QuizScreenState();
}

class _QuizScreenState extends State<QuizScreen> {
  final Map<int, int> answers = {};
  final Set<int> revealed = {};
  final Set<int> wrongQuestions = {};

  List<int> questionOrder = List.generate(quiz.length, (i) => i);
  int currentQuestion = 0;
  bool submitted = false;
  bool wrongOnly = false;

  bool get isDark => Theme.of(context).brightness == Brightness.dark;

  Color get pageColor =>
      isDark ? const Color(0xFF090909) : const Color(0xFFF5F1E8);
  Color get panelColor => isDark ? const Color(0xFF171717) : Colors.white;
  Color get primaryText =>
      isDark ? const Color(0xFFFFF4D6) : const Color(0xFF17130B);
  Color get secondaryText =>
      isDark ? const Color(0xFFB8AE98) : const Color(0xFF746B5B);

  int get activeIndex => questionOrder[currentQuestion];

  int get score =>
      questionOrder.where((i) => answers[i] == quiz[i].answer).length;

  double get progress =>
      questionOrder.isEmpty ? 0 : answers.length / questionOrder.length;

  @override
  void initState() {
    super.initState();
    _loadWrongQuestions();
  }

  Future<void> _loadWrongQuestions() async {
    final prefs = await SharedPreferences.getInstance();
    final saved = prefs.getStringList('quiz_wrong_question_ids') ?? [];

    if (!mounted) return;
    setState(() {
      wrongQuestions
        ..clear()
        ..addAll(saved.map(int.tryParse).whereType<int>().where(
              (i) => i >= 0 && i < quiz.length,
            ));
    });
  }

  Future<void> _startWrongPractice() async {
    final prefs = await SharedPreferences.getInstance();
    final saved = prefs.getStringList('quiz_wrong_question_ids') ?? [];
    final wrong = saved
        .map(int.tryParse)
        .whereType<int>()
        .where((i) => i >= 0 && i < quiz.length)
        .toList();

    if (!mounted) return;

    if (wrong.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('এখনো কোনো ভুল প্রশ্ন নেই। আগে একটি কুইজ দিন।'),
        ),
      );
      return;
    }

    setState(() {
      questionOrder = wrong;
      answers.clear();
      revealed.clear();
      currentQuestion = 0;
      submitted = false;
      wrongOnly = true;
    });
  }

  void _startAllPractice() {
    setState(() {
      questionOrder = List.generate(quiz.length, (i) => i);
      answers.clear();
      revealed.clear();
      currentQuestion = 0;
      submitted = false;
      wrongOnly = false;
    });
  }

  int lastXpEarned = 0;
  int totalXpAfterQuiz = 0;
  int levelBeforeQuiz = 1;

  Future<void> _submit() async {
    if (answers.length != questionOrder.length || submitted) return;

    final finalScore = score;
    final total = questionOrder.length;

    setState(() => submitted = true);

    final prefs = await SharedPreferences.getInstance();

    final correctIds = questionOrder
        .where((index) => answers[index] == quiz[index].answer)
        .toList();

    await LearningStore.markActiveDay();

    final xpBeforeQuiz = await LearningStore.getTotalXp();
    levelBeforeQuiz = (xpBeforeQuiz ~/ 100) + 1;

    final earnedXp = await LearningStore.awardQuizXp(correctIds);
    lastXpEarned = earnedXp;
    totalXpAfterQuiz = await LearningStore.getTotalXp();

    if (mounted) {
      setState(() {});
    }

    final attempts = prefs.getInt('quiz_attempts') ?? 0;
    final totalCorrect = prefs.getInt('quiz_total_correct') ?? 0;
    final totalQuestions = prefs.getInt('quiz_total_questions') ?? 0;

    await prefs.setInt('quiz_attempts', attempts + 1);
    await prefs.setInt('quiz_total_correct', totalCorrect + finalScore);
    await prefs.setInt('quiz_total_questions', totalQuestions + total);

    if (!wrongOnly) {
      await prefs.setInt('lesson1_score', finalScore);
      await prefs.setInt('lesson1_total_questions', total);
    }

    final oldWrong = (prefs.getStringList('quiz_wrong_question_ids') ?? [])
        .map(int.tryParse)
        .whereType<int>()
        .toSet();

    oldWrong.removeAll(questionOrder);

    for (final index in questionOrder) {
      if (answers[index] != quiz[index].answer) {
        oldWrong.add(index);
      }
    }

    await prefs.setStringList(
      'quiz_wrong_question_ids',
      oldWrong.map((i) => i.toString()).toList(),
    );

    if (mounted) {
      setState(() {
        wrongQuestions
          ..clear()
          ..addAll(oldWrong);
      });
    }
  }

  void _restart() {
    setState(() {
      answers.clear();
      revealed.clear();
      currentQuestion = 0;
      submitted = false;
    });
  }

  void _next() {
    if (currentQuestion < questionOrder.length - 1) {
      setState(() => currentQuestion++);
    } else if (answers.length == questionOrder.length) {
      _submit();
    }
  }

  void _selectAnswer(int option) {
    if (submitted || revealed.contains(activeIndex)) return;

    final answeredIndex = activeIndex;

    setState(() {
      answers[answeredIndex] = option;
      revealed.add(answeredIndex);

      if (option != quiz[answeredIndex].answer) {
        wrongQuestions.add(answeredIndex);
      }
    });

    // সংক্ষিপ্ত ফিডব্যাক দেখিয়ে স্বয়ংক্রিয়ভাবে পরের প্রশ্নে যাবে।
    final answeredPosition = currentQuestion;
    Future.delayed(const Duration(milliseconds: 500), () {
      if (!mounted || submitted) return;
      if (currentQuestion != answeredPosition) return;
      if (activeIndex != answeredIndex) return;
      if (!revealed.contains(answeredIndex)) return;
      if (answers[answeredIndex] != option) return;

      _next();
    });
  }

