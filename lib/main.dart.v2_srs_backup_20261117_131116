class _WritingPracticeScreenState extends State<WritingPracticeScreen> {
  final TextEditingController _controller = TextEditingController();

  static const List<_WritingPrompt> _questions = [
    _WritingPrompt('你好', 'Nǐ hǎo', 'হ্যালো / নমস্কার'),
    _WritingPrompt('谢谢', 'Xièxie', 'ধন্যবাদ'),
    _WritingPrompt('再见', 'Zàijiàn', 'বিদায়'),
    _WritingPrompt('中国', 'Zhōngguó', 'চীন'),
    _WritingPrompt('学生', 'Xuésheng', 'শিক্ষার্থী'),
    _WritingPrompt('老师', 'Lǎoshī', 'শিক্ষক'),
    _WritingPrompt('朋友', 'Péngyou', 'বন্ধু'),
    _WritingPrompt('学校', 'Xuéxiào', 'বিদ্যালয়'),
    _WritingPrompt('水', 'Shuǐ', 'পানি'),
    _WritingPrompt('学习', 'Xuéxí', 'পড়াশোনা / শেখা'),
  ];

  int _index = 0;
  int _score = 0;
  bool _checked = false;
  bool? _correct;

  _WritingPrompt get _current => _questions[_index];

  void _checkAnswer() {
    if (_checked || _controller.text.trim().isEmpty) return;

    final answer = _controller.text.trim().replaceAll(' ', '');
    final expected = _current.chinese.replaceAll(' ', '');
    final correct = answer == expected;

    setState(() {
      _checked = true;
      _correct = correct;
      if (correct) _score++;
    });
  }

  void _nextQuestion() {
    setState(() {
      _index = (_index + 1) % _questions.length;
      _controller.clear();
      _checked = false;
      _correct = null;
    });
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

