  Widget _buildOption({
    required int index,
    required String label,
    required bool selected,
    required int correctAnswer,
    required bool hasAnswered,
  }) {
    final isCorrect = hasAnswered && index == correctAnswer;
    final isWrongSelected = hasAnswered && selected && index != correctAnswer;

    Color borderColor =
        selected ? AppColors.gold : AppColors.gold.withValues(alpha: 0.22);
    Color background = selected
        ? AppColors.gold.withValues(alpha: isDark ? 0.19 : 0.13)
        : (isDark ? const Color(0xFF202020) : const Color(0xFFFFFCF5));

    if (isCorrect) {
      borderColor = AppColors.success;
      background = AppColors.success.withValues(alpha: 0.10);
    } else if (isWrongSelected) {
      borderColor = AppColors.red;
      background = AppColors.red.withValues(alpha: 0.10);
    }

    return Padding(
      padding: const EdgeInsets.only(bottom: 10),
      child: InkWell(
        borderRadius: BorderRadius.circular(16),
        onTap: hasAnswered ? null : () => _selectAnswer(index),
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 180),
          padding: const EdgeInsets.symmetric(
            horizontal: 14,
            vertical: 15,
          ),
          decoration: BoxDecoration(
            color: background,
            borderRadius: BorderRadius.circular(16),
            border: Border.all(
              color: borderColor,
              width: selected || isCorrect || isWrongSelected ? 1.7 : 1,
            ),
          ),
          child: Row(
            children: [
              Container(
                width: 32,
                height: 32,
                alignment: Alignment.center,
                decoration: BoxDecoration(
                  color: selected
                      ? AppColors.gold
                      : AppColors.gold.withValues(alpha: 0.13),
                  borderRadius: BorderRadius.circular(10),
                ),
                child: Text(
                  String.fromCharCode(65 + index),
                  style: TextStyle(
                    color: selected ? const Color(0xFF17130B) : AppColors.gold,
                    fontWeight: FontWeight.w900,
                  ),
                ),
              ),
              const SizedBox(width: 13),
              Expanded(
                child: Text(
                  label,
                  style: TextStyle(
                    color: primaryText,
                    fontSize: 15,
                    fontWeight: selected ? FontWeight.w900 : FontWeight.w600,
                  ),
                ),
              ),
              Icon(
                isCorrect
                    ? Icons.check_circle_rounded
                    : isWrongSelected
                        ? Icons.cancel_rounded
                        : selected
                            ? Icons.radio_button_checked_rounded
                            : Icons.radio_button_off_rounded,
                color: isCorrect
                    ? AppColors.success
                    : isWrongSelected
                        ? AppColors.red
                        : selected
                            ? AppColors.gold
                            : secondaryText,
              ),
            ],
          ),
        ),
      ),
    );
  }

