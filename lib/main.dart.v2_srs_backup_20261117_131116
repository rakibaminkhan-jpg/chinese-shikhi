                          fontWeight: FontWeight.w800,
                          color: AppColors.red,
                        ),
                      ),
                      const SizedBox(height: 24),
                      FilledButton.icon(
                        onPressed: _restart,
                        icon: const Icon(Icons.refresh_rounded),
                        label: const Text('আবার খেলুন'),
                      ),
                    ],
                  ),
                )
              : Column(
                  crossAxisAlignment: CrossAxisAlignment.stretch,
                  children: [
                    const Text(
                      'শব্দের সঠিক বাংলা অর্থ নির্বাচন করুন',
