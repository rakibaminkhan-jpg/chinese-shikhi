              _buildSectionTitle(
                'শেখার সরঞ্জাম',
                'আপনার শেখার যাত্রা সহজ করুন',
              ),
              const SizedBox(height: 11),
              Row(
                children: [
                  Expanded(
                    child: _toolCard(
                      icon: Icons.style_rounded,
                      title: 'Flashcards',
                      subtitle: 'কার্ড দিয়ে অনুশীলন',
                      color: const Color(0xFFB71C1C),
