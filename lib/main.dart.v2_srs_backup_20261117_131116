class FlashcardScreen extends StatefulWidget {
  const FlashcardScreen({super.key});

  @override
  State<FlashcardScreen> createState() => _FlashcardScreenState();
}

class _FlashcardScreenState extends State<FlashcardScreen> {
  late final Future<List<VocabWord>> _wordsFuture;
  int _selectedLevel = 1;
  int _currentIndex = 0;
  bool _showBack = false;
  bool _isShuffling = false;
  final Set<String> _learned = {};
  final Set<String> _seen = {};

  @override
  void initState() {
    super.initState();
    _wordsFuture = VocabService.loadWords();
    _loadLearned();
  }

  Future<void> _loadLearned() async {
    final words = await LearningStore.getLearnedWords();
    if (!mounted) return;
    setState(() => _learned.addAll(words));
  }

  String _id(VocabWord word) => LearningStore.wordId(
        level: word.level,
        hanzi: word.hanzi,
        pinyin: word.pinyin,
      );

  void _next(List<VocabWord> words) {
    if (words.isEmpty) return;
    setState(() {
      _currentIndex = (_currentIndex + 1) % words.length;
      _showBack = false;
      _seen.add(_id(words[_currentIndex]));
    });
  }

  void _previous(List<VocabWord> words) {
    if (words.isEmpty) return;
    setState(() {
      _currentIndex = (_currentIndex - 1 + words.length) % words.length;
      _showBack = false;
      _seen.add(_id(words[_currentIndex]));
    });
  }

  void _shuffle(List<VocabWord> words) {
    if (words.length < 2) return;
    final current = _currentIndex;
    var nextIndex = current;
    while (nextIndex == current) {
      nextIndex = DateTime.now().microsecondsSinceEpoch % words.length;
      if (nextIndex == current) {
        nextIndex = (current + 1) % words.length;
      }
    }
    setState(() {
      _currentIndex = nextIndex;
      _showBack = false;
      _seen.add(_id(words[_currentIndex]));
      _isShuffling = true;
    });
    Future.delayed(const Duration(milliseconds: 500), () {
      if (mounted) setState(() => _isShuffling = false);
    });
  }

  Future<void> _markLearned(VocabWord word, List<VocabWord> words) async {
    final id = _id(word);
    await LearningStore.markLearned(id);
    if (!mounted) return;

    setState(() {
      _learned.add(id);
      _showBack = false;
    });

    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(
        content: Text('দারুণ! শব্দটি শেখা তালিকায় যোগ হয়েছে।'),
        duration: Duration(milliseconds: 900),
      ),
    );

    if (words.length > 1) {
      _next(words);
    }
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'স্মার্ট Flashcards',
          style: TextStyle(fontWeight: FontWeight.w900),
        ),
        actions: [
          IconButton(
            tooltip: 'শব্দ এলোমেলো করুন',
            onPressed: () {
              // শব্দের তালিকা FutureBuilder থেকে নিয়ন্ত্রণ করা হয়।
              setState(() => _isShuffling = !_isShuffling);
            },
            icon: const Icon(Icons.shuffle_rounded),
          ),
        ],
      ),
      body: FutureBuilder<List<VocabWord>>(
        future: _wordsFuture,
        builder: (context, snapshot) {
          if (snapshot.connectionState == ConnectionState.waiting) {
            return const Center(child: CircularProgressIndicator());
          }

          if (snapshot.hasError || !snapshot.hasData) {
            return Center(
              child: Padding(
                padding: const EdgeInsets.all(24),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    const Icon(Icons.error_outline_rounded, size: 48),
                    const SizedBox(height: 12),
                    const Text('শব্দ লোড করা যায়নি।'),
                    const SizedBox(height: 12),
                    OutlinedButton(
                      onPressed: () => setState(() {}),
                      child: const Text('আবার চেষ্টা করুন'),
                    ),
                  ],
                ),
              ),
            );
          }

          final allWords = snapshot.data!;
          final words =
              allWords.where((word) => word.level == _selectedLevel).toList();

          if (words.isEmpty) {
            return const Center(child: Text('এই লেভেলে কোনো শব্দ নেই।'));
          }

          final index = _currentIndex.clamp(0, words.length - 1);
          final word = words[index];
          final id = _id(word);
          final isLearned = _learned.contains(id);
          final learnedForLevel =
              words.where((item) => _learned.contains(_id(item))).length;
          final progress = words.isEmpty ? 0.0 : learnedForLevel / words.length;

          _seen.add(id);

          return SafeArea(
