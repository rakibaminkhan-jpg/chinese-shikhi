  late final Future<List<VocabWord>> _wordsFuture;

  // প্রতি ২৪ ঘণ্টায় পরিবর্তিত HSK 4-এর আজকের শব্দ।
  int _dailyWordIndex = 0;
  List<VocabWord> _dailyHsk4Words = [];
  bool _dailyWordLoading = true;
  Timer? _dailyWordTimer;

  @override
  void initState() {
    super.initState();
    _wordsFuture = VocabService.loadWords();
    _loadDailyHsk4Word();
    _readScore();
    _loadLearningStats();
    _loadStudyStats();
  }

  Future<void> _loadDailyHsk4Word() async {
    try {
      final allWords = await _wordsFuture;
      final hsk4Words = allWords.where((word) => word.level == 4).toList();

      if (hsk4Words.isEmpty) {
        if (!mounted) return;
        setState(() {
          _dailyHsk4Words = [];
          _dailyWordLoading = false;
        });
        return;
      }

      final prefs = await SharedPreferences.getInstance();
      final now = DateTime.now();

      int index = prefs.getInt('daily_hsk4_word_index') ?? -1;
      final savedTimestamp = prefs.getInt('daily_hsk4_word_timestamp');

      DateTime changedAt;

      if (index < 0 || savedTimestamp == null) {
        index = 0;
        changedAt = now;
      } else {
        index = index % hsk4Words.length;
        changedAt = DateTime.fromMillisecondsSinceEpoch(savedTimestamp);

        final elapsed = now.difference(changedAt);

        if (elapsed >= const Duration(hours: 24)) {
          final completedPeriods = elapsed.inHours ~/ 24;
          index = (index + completedPeriods) % hsk4Words.length;
          changedAt = changedAt.add(
            Duration(hours: 24 * completedPeriods),
          );
        }
      }

      await prefs.setInt('daily_hsk4_word_index', index);
      await prefs.setInt(
        'daily_hsk4_word_timestamp',
        changedAt.millisecondsSinceEpoch,
      );

      if (!mounted) return;

      _dailyWordTimer?.cancel();

      setState(() {
        _dailyHsk4Words = hsk4Words;
        _dailyWordIndex = index;
        _dailyWordLoading = false;
      });

      final nextChange = changedAt.add(const Duration(hours: 24));
      final remaining = nextChange.difference(DateTime.now());

      _dailyWordTimer = Timer(
        remaining.isNegative ? Duration.zero : remaining,
        () {
          _loadDailyHsk4Word();
        },
      );
    } catch (error) {
      if (!mounted) return;
      setState(() {
        _dailyWordLoading = false;
      });
    }
  }

  Future<void> _loadStudyStats() async {
    final values = await Future.wait<int>([
      LearningStore.getTotalStudySeconds(),
      LearningStore.getTodayStudySeconds(),
      LearningStore.getTotalXp(),
    ]);

    final calendar = await LearningStore.getMonthStudySeconds(_calendarMonth);

    if (!mounted) return;

    setState(() {
      _totalStudySeconds = values[0];
      _todayStudySeconds = values[1];
      _totalXp = values[2];
      _learningLevel = (values[2] ~/ 100) + 1;
      _monthStudySeconds = calendar;
    });
  }

  Future<void> _loadLearningStats() async {
    final values = await Future.wait<int>([
      LearningStore.getTotalLearnedCount(),
      LearningStore.getTodayLearnedCount(),
      LearningStore.getDailyGoal(),
      LearningStore.getStreak(),
    ]);
    final goalLocked = await LearningStore.isDailyGoalLocked();

    if (!mounted) return;
    setState(() {
      _learnedCount = values[0];
      _todayLearned = values[1];
      _dailyGoal = values[2];
      _streak = values[3];
      _dailyGoalLocked = goalLocked;
    });
  }

  Future<void> _changeDailyGoal(int goal) async {
    if (_dailyGoalLocked) return;

    await LearningStore.setDailyGoal(goal);
    if (!mounted) return;

    final locked = await LearningStore.isDailyGoalLocked();

    setState(() {
      _dailyGoal = goal;
      _dailyGoalLocked = locked;
    });
  }

