class _PathLessonPlayScreenState extends State<_PathLessonPlayScreen> {
  bool _saving = false;

  Future<void> _answer(String answer) async {
    if (_saving) return;

    if (answer != widget.lesson.answer) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('আবার চেষ্টা করো। সঠিক উত্তরটি খুঁজে বের করো!'),
          behavior: SnackBarBehavior.floating,
        ),
      );
      return;
    }

    setState(() => _saving = true);
    final earned = await LearningStore.completePathLesson(widget.lesson.id);

    if (!mounted) return;

    await showDialog<void>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: const Text('দারুণ! লেসন সম্পন্ন 🎉'),
        content: Text(
          earned ? '+20 XP অর্জন করেছ!' : 'এই লেসন আগে সম্পন্ন হয়েছে।',
        ),
        actions: [
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext),
            child: const Text('চালিয়ে যান'),
          ),
        ],
      ),
    );

    if (!mounted) return;
    Navigator.pop(context, true);
  }

  @override
  Widget build(BuildContext context) {
